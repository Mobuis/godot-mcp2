{
  "name": "godot-mcp-server",
  "version": "0.1.0",
  "description": "MCP server bridging AI assistants to the Godot editor",
  "type": "module",
  "bin": {
    "godot-mcp": "./build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "parity": "node scripts/check-parity.mjs",
    "invariants": "node scripts/check-invariants.mjs",
    "prebuild": "node scripts/check-parity.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "ws": "^8.18.2",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/ws": "^8.18.1",
    "typescript": "^5.8.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
